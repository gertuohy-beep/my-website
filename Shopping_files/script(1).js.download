window.cxs && window.cxs.setOptions({ prefix: "c2-" });
window.wsb=window.wsb||{};window.wsb["Theme13"]=window.wsb["Theme13"]||window.radpack("@widget/LAYOUT/bs-layout13-Theme-publish-Theme").then(function(t){return new t.default();});
window.wsb['context-bs-1']=JSON.parse("{\"env\":\"production\",\"renderMode\":\"PUBLISH\",\"fonts\":[\"league-spartan\",\"source-sans-pro\",\"montserrat\"],\"colors\":[\"#261d59\"],\"fontScale\":\"medium\",\"locale\":\"en-IE\",\"language\":\"en\",\"resellerId\":1,\"internalLinks\":{\"a2dfffc3-e32c-45a4-8885-e841c0483ac3\":{\"pageId\":\"464ebc2e-7e6f-4d9c-9204-aea8600b6b89\",\"routePath\":\"/\"}},\"isInternalPage\":true,\"navigationMap\":{\"093f7349-56c5-440b-94d0-2f61ef548664\":{\"isFlyoutMenu\":false,\"active\":false,\"pageId\":\"093f7349-56c5-440b-94d0-2f61ef548664\",\"name\":\"Karaoke\",\"href\":\"/karaoke\",\"target\":\"\",\"visible\":false,\"isSectionLink\":false,\"requiresAuth\":false,\"tags\":[\"FLEX\",\"HTML\"],\"rel\":\"\",\"type\":\"page\",\"showInFooter\":false},\"2dc25f0d-ac71-45f8-9535-eb5f9670f8d3\":{\"isFlyoutMenu\":false,\"active\":false,\"pageId\":\"2dc25f0d-ac71-45f8-9535-eb5f9670f8d3\",\"name\":\"Jump\",\"href\":\"/jump\",\"target\":\"\",\"visible\":false,\"isSectionLink\":false,\"requiresAuth\":false,\"tags\":[\"HTML\"],\"rel\":\"\",\"type\":\"page\",\"showInFooter\":false},\"464ebc2e-7e6f-4d9c-9204-aea8600b6b89\":{\"isFlyoutMenu\":false,\"active\":false,\"pageId\":\"464ebc2e-7e6f-4d9c-9204-aea8600b6b89\",\"name\":\"Home\",\"href\":\"/\",\"target\":\"\",\"visible\":true,\"requiresAuth\":false,\"tags\":[\"ABOUT\",\"CONTACT\"],\"rel\":\"\",\"type\":\"page\",\"showInFooter\":false},\"93da632f-ead4-42ee-8f14-e674b3261ffe\":{\"isFlyoutMenu\":false,\"active\":true,\"pageId\":\"93da632f-ead4-42ee-8f14-e674b3261ffe\",\"name\":\"Shopping\",\"href\":\"/shopping\",\"target\":\"\",\"visible\":false,\"isSectionLink\":false,\"requiresAuth\":false,\"tags\":[\"HTML\"],\"rel\":\"\",\"type\":\"page\",\"showInFooter\":false},\"b6fb5834-0a2e-4e2d-92eb-3885accd3165\":{\"isFlyoutMenu\":false,\"active\":false,\"pageId\":\"b6fb5834-0a2e-4e2d-92eb-3885accd3165\",\"name\":\"404\",\"href\":\"/404\",\"target\":\"\",\"visible\":false,\"requiresAuth\":false,\"tags\":[\"INTRODUCTION\"],\"rel\":\"\",\"type\":\"page\",\"showInFooter\":false},\"d883997a-5dcf-4e63-803d-071d4b863080\":{\"isFlyoutMenu\":false,\"active\":false,\"pageId\":\"d883997a-5dcf-4e63-803d-071d4b863080\",\"name\":\"Privacy Policy\",\"href\":\"/privacy-policy\",\"target\":\"\",\"visible\":false,\"requiresAuth\":false,\"tags\":[\"PRIVACY\"],\"rel\":\"\",\"type\":\"page\",\"showInFooter\":true}},\"dials\":{\"colors\":[{\"id\":\"#261d59\",\"meta\":{\"primary\":\"rgb(38, 29, 89)\",\"accent\":\"rgb(17, 17, 17)\",\"neutral\":\"rgb(255, 255, 255)\"}}],\"fonts\":{\"primary\":{\"id\":\"league-spartan\",\"description\":\"\",\"meta\":{\"order\":20,\"primary\":{\"id\":\"league-spartan\",\"name\":\"League Spartan\",\"url\":\"//img1.wsimg.com/blobby/go/font/LeagueSpartan/league-spartan.css\",\"family\":\"'League Spartan', arial, helvetica, sans-serif\",\"size\":16,\"weight\":400,\"weights\":[400,700]},\"alternate\":{\"id\":\"helvetica\",\"name\":\"Helvetica\",\"url\":\"\",\"family\":\"Helvetica, arial, sans-serif\",\"size\":16,\"weight\":400,\"weights\":[400,700],\"styles\":{\"letterSpacing\":\"normal\",\"textTransform\":\"none\"}}}},\"alternate\":{\"id\":\"source-sans-pro\",\"description\":\"\",\"tags\":[],\"meta\":{\"order\":20,\"alternate\":{\"id\":\"source-sans-pro\",\"name\":\"Source Sans Pro\",\"url\":\"//fonts.googleapis.com/css?family=Source+Sans+Pro:300,300i,400,400i,700,700i&display=swap\",\"family\":\"'Source Sans Pro', arial, sans-serif\",\"size\":16,\"weight\":400,\"weights\":[300,400,700],\"styles\":{\"letterSpacing\":\"normal\",\"textTransform\":\"none\"}}}},\"logo\":{\"id\":\"montserrat\",\"description\":\"Urban, upright, fonts that offer stylish, contemporary professionalism.\",\"tags\":[\"sans-serif\",\"modern\",\"clean\"],\"meta\":{\"order\":23,\"logo\":{\"id\":\"montserrat\",\"name\":\"Montserrat\",\"url\":\"//fonts.googleapis.com/css?family=Montserrat:600,700&display=swap\",\"family\":\"'Montserrat', sans-serif\",\"size\":16,\"weight\":700,\"weights\":[600,700],\"styles\":{\"letterSpacing\":\"4px\",\"textTransform\":\"uppercase\",\"fontWeight\":700,\"fontSize\":\"xlarge\"}}}}}},\"theme\":\"Theme13\",\"paintJob\":\"LIGHT\"}");
Core.utils.deferBootstrap({elId:'bs-1',componentName:'@widget/HTML/bs-Component',props:JSON.parse("{\"data-aid\":\"AUTOIFRAME_RENDERED\",\"centerContent\":false,\"htmlSrc\":\"<html lang=\\\"en\\\" class=\\\"bg-gray-50\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>BillSplit \u2022 Fair Shopping Split</title>\\n    <script src=\\\"https://cdn.tailwindcss.com\\\"><$script>\\n    <link rel=\\\"stylesheet\\\" href=\\\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\\\">\\n    <style>\\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600&display=swap');\\n        body { font-family: 'Inter', system_ui, sans-serif; margin: 0; padding: 0; }\\n        .title-font { font-family: 'Space Grotesk', sans-serif; }\\n    <\/style>\\n</head>\\n<body>\\n    \u003C!-- Main Wrapper relative to contain everything -->\\n    <div class=\\\"relative max-w-2xl mx-auto min-h-screen bg-white shadow-xl flex flex-col\\\">\\n        \\n        \u003C!-- Header -->\\n        <div class=\\\"bg-gradient-to-r from-indigo-600 to-violet-600 text-white px-6 py-5 flex items-center gap-3 shrink-0\\\">\\n            <i class=\\\"fa-solid fa-receipt text-3xl\\\"></i>\\n            <div>\\n                <h1 class=\\\"title-font text-3xl font-semibold tracking-tight\\\">BillSplit</h1>\\n                <p class=\\\"text-indigo-200 text-sm\\\">Fair shopping bill splitter</p>\\n            </div>\\n        </div>\\n\\n        \u003C!-- APP CONTENT AREA -->\\n        <div id=\\\"main-content\\\" class=\\\"flex-1 p-6 overflow-auto\\\">\\n            \\n            \u003C!-- STEP 1: Setup -->\\n            <div id=\\\"step-1\\\" class=\\\"space-y-8\\\">\\n                <div class=\\\"flex justify-between items-start\\\">\\n                    <div>\\n                        <h2 class=\\\"text-2xl font-semibold text-gray-900\\\">Let's split the bill</h2>\\n                        <p class=\\\"text-gray-600\\\">Tell us who paid and how many people are sharing.</p>\\n                    </div>\\n                    \u003C!-- The Info Button -->\\n                    <button onclick=\\\"showInstructions()\\\" type=\\\"button\\\" \\n                            class=\\\"w-10 h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-600 rounded-2xl flex items-center justify-center text-2xl transition-colors\\\">\\n                        <i class=\\\"fa-solid fa-circle-info\\\"></i>\\n                    </button>\\n                </div>\\n                \\n                <div class=\\\"space-y-6\\\">\\n                    <div>\\n                        <label class=\\\"block text-sm font-medium text-gray-700 mb-1\\\">Currency</label>\\n                        <select id=\\\"currency-select\\\" \\n                                class=\\\"w-full px-4 py-3 border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-lg bg-white\\\">\\n                            <option value=\\\"EUR\\\">\u20AC Euro (EUR)</option>\\n                            <option value=\\\"USD\\\">$ US Dollar (USD)</option>\\n                            <option value=\\\"GBP\\\">\u00A3 British Pound (GBP)</option>\\n                            <option value=\\\"INR\\\">\u20B9 Indian Rupee (INR)</option>\\n                            <option value=\\\"CAD\\\">C$ Canadian Dollar (CAD)</option>\\n                            <option value=\\\"AUD\\\">A$ Australian Dollar (AUD)</option>\\n                            <option value=\\\"JPY\\\">\u00A5 Japanese Yen (JPY)</option>\\n                        </select>\\n                    </div>\\n\\n                    <div>\\n                        <label class=\\\"block text-sm font-medium text-gray-700 mb-1\\\">Who paid the full bill?</label>\\n                        <input id=\\\"payer-name\\\" type=\\\"text\\\" placeholder=\\\"e.g. Sarah\\\" \\n                               class=\\\"w-full px-4 py-3 border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-indigo-500 text-lg\\\">\\n                    </div>\\n                    \\n                    <div>\\n                        <label class=\\\"block text-sm font-medium text-gray-700 mb-1\\\">How many people in total?</label>\\n                        <div class=\\\"flex gap-3\\\">\\n                            <button type=\\\"button\\\" id=\\\"btn-people-2\\\" onclick=\\\"setPeople(2)\\\" class=\\\"flex-1 py-4 bg-white border-2 border-gray-200 text-gray-900 rounded-3xl text-lg font-semibold transition-all duration-200\\\">2</button>\\n                            <button type=\\\"button\\\" id=\\\"btn-people-3\\\" onclick=\\\"setPeople(3)\\\" class=\\\"flex-1 py-4 bg-white border-2 border-gray-200 text-gray-900 rounded-3xl text-lg font-semibold transition-all duration-200\\\">3</button>\\n                            <button type=\\\"button\\\" id=\\\"btn-people-4\\\" onclick=\\\"setPeople(4)\\\" class=\\\"flex-1 py-4 bg-white border-2 border-gray-200 text-gray-900 rounded-3xl text-lg font-semibold transition-all duration-200\\\">4</button>\\n                            <button type=\\\"button\\\" id=\\\"btn-people-5\\\" onclick=\\\"setPeople(5)\\\" class=\\\"flex-1 py-4 bg-white border-2 border-gray-200 text-gray-900 rounded-3xl text-lg font-semibold transition-all duration-200\\\">5</button>\\n                            <button type=\\\"button\\\" id=\\\"btn-people-custom\\\" onclick=\\\"showCustomPeople()\\\" class=\\\"flex-1 py-4 bg-white border-2 border-gray-200 text-gray-900 rounded-3xl text-lg font-semibold transition-all duration-200\\\">6+</button>\\n                        </div>\\n                        <input id=\\\"num-people\\\" type=\\\"text\\\" inputmode=\\\"numeric\\\" pattern=\\\"[0-9]*\\\" placeholder=\\\"Enter amount of people\\\"\\n                               oninput=\\\"this.value = this.value.replace(/[^0-9]/g, ''); handleCustomInput(this.value);\\\"\\n                               class=\\\"mt-3 w-full px-4 py-3 border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-indigo-500 hidden\\\">\\n                    </div>\\n                </div>\\n\\n                <button onclick=\\\"goToStep2()\\\" type=\\\"button\\\" \\n                        class=\\\"w-full bg-indigo-600 hover:bg-indigo-700 text-white py-4 rounded-3xl text-lg font-semibold flex items-center justify-center gap-2\\\">\\n                    Continue <i class=\\\"fa-solid fa-arrow-right\\\"></i>\\n                </button>\\n            </div>\\n\\n            \u003C!-- STEP 2: Enter Names -->\\n            <div id=\\\"step-2\\\" class=\\\"hidden space-y-6\\\">\\n                <div class=\\\"flex items-center justify-between\\\">\\n                    <button onclick=\\\"backToStep1()\\\" type=\\\"button\\\" class=\\\"text-gray-500 hover:text-gray-700 flex items-center gap-1\\\">\\n                        <i class=\\\"fa-solid fa-arrow-left\\\"></i> Back\\n                    </button>\\n                    <h2 class=\\\"text-xl font-semibold\\\">Enter everyone's names</h2>\\n                </div>\\n                <div id=\\\"names-container\\\" class=\\\"space-y-4\\\"></div>\\n                <button onclick=\\\"goToStep3()\\\" type=\\\"button\\\" class=\\\"w-full bg-indigo-600 hover:bg-indigo-700 text-white py-4 rounded-3xl text-lg font-semibold\\\">\\n                    Next: Add Items\\n                </button>\\n            </div>\\n\\n            \u003C!-- STEP 3: Add Items -->\\n            <div id=\\\"step-3\\\" class=\\\"hidden\\\">\\n                <div class=\\\"flex justify-between items-center mb-6\\\">\\n                    <h2 class=\\\"text-xl font-semibold\\\">Shopping List</h2>\\n                    <div class=\\\"text-sm text-gray-500\\\">\\n                        <span id=\\\"item-counter\\\" class=\\\"font-mono font-medium text-indigo-600\\\">0</span> items added\\n                    </div>\\n                </div>\\n                \\n                \u003C!-- Main Item Input Card -->\\n                <div class=\\\"bg-gray-50 border border-gray-200 rounded-3xl p-6 mb-4\\\">\\n                    <div class=\\\"flex items-center gap-3 mb-5\\\">\\n                        <div id=\\\"current-item-number\\\" class=\\\"w-8 h-8 bg-indigo-600 text-white rounded-2xl flex items-center justify-center font-semibold\\\">1</div>\\n                        <h3 class=\\\"font-medium text-lg\\\">New Item</h3>\\n                    </div>\\n                    \\n                    <div class=\\\"grid grid-cols-2 gap-4 mb-6\\\">\\n                        <div>\\n                            <label class=\\\"block text-sm font-medium text-gray-700 mb-2\\\">Item Cost (<span id=\\\"cost-currency\\\">\u20AC</span>)</label>\\n                            <input id=\\\"item-cost\\\" type=\\\"text\\\" inputmode=\\\"decimal\\\" placeholder=\\\"20.00\\\"\\n                                   oninput=\\\"sanitizeNumericInput(this)\\\"\\n                                   class=\\\"w-full px-5 py-4 text-3xl font-semibold border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-indigo-500\\\">\\n                        </div>\\n                        <div>\\n                            <label class=\\\"block text-sm font-medium text-gray-700 mb-2\\\">Item Discount (<span id=\\\"disc-currency\\\">\u20AC</span>)</label>\\n                            <input id=\\\"item-discount\\\" type=\\\"text\\\" inputmode=\\\"decimal\\\" placeholder=\\\"0.00\\\" value=\\\"0\\\"\\n                                   oninput=\\\"sanitizeNumericInput(this)\\\"\\n                                   class=\\\"w-full px-5 py-4 text-3xl font-semibold border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-indigo-500\\\">\\n                        </div>\\n                    </div>\\n                    \\n                    <div>\\n                        <label class=\\\"block text-sm font-medium text-gray-700 mb-3\\\">Who pays for this item?</label>\\n                        <div id=\\\"checkboxes-container\\\" class=\\\"grid grid-cols-2 gap-3\\\"></div>\\n                    </div>\\n                    \\n                    <button onclick=\\\"addItem()\\\" type=\\\"button\\\" \\n                            class=\\\"mt-5 w-full bg-white border border-indigo-300 hover:border-indigo-400 text-indigo-700 py-4 rounded-3xl font-semibold flex items-center justify-center gap-2 transition-colors\\\">\\n                        <i class=\\\"fa-solid fa-plus\\\"></i> Add Item to List\\n                    </button>\\n                </div>\\n\\n                \u003C!-- Store Voucher Input Card -->\\n                <div class=\\\"bg-amber-50/60 border border-amber-200 rounded-3xl p-6 mb-6\\\">\\n                    <div class=\\\"flex items-center gap-3 mb-4\\\">\\n                        <div class=\\\"w-8 h-8 bg-amber-500 text-white rounded-2xl flex items-center justify-center font-semibold\\\">\\n                            <i class=\\\"fa-solid fa-ticket text-sm\\\"></i>\\n                        </div>\\n                        <div>\\n                            <h3 class=\\\"font-medium text-base text-amber-900\\\">Store Voucher</h3>\\n                            <p class=\\\"text-xs text-amber-700/80\\\">Splits deduction evenly among everyone sharing the bill</p>\\n                        </div>\\n                    </div>\\n                    \\n                    <div class=\\\"flex gap-3 items-end\\\">\\n                        <div class=\\\"flex-1\\\">\\n                            <label class=\\\"block text-xs font-medium text-amber-800 mb-1\\\">Voucher Value (<span id=\\\"voucher-currency\\\">\u20AC</span>)</label>\\n                            <input id=\\\"store-voucher\\\" type=\\\"text\\\" inputmode=\\\"decimal\\\" placeholder=\\\"10.00\\\"\\n                                   oninput=\\\"sanitizeNumericInput(this)\\\"\\n                                   class=\\\"w-full px-4 py-3 text-xl font-semibold bg-white border border-amber-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-amber-500 text-amber-900\\\">\\n                        </div>\\n                        <button onclick=\\\"addVoucher()\\\" type=\\\"button\\\"\\n                                class=\\\"bg-amber-600 hover:bg-amber-700 text-white px-5 py-3.5 rounded-2xl font-semibold text-sm flex items-center gap-2 h-[50px] transition-colors\\\">\\n                            Apply Voucher\\n                        </button>\\n                    </div>\\n                </div>\\n                \\n                \u003C!-- Inline Error Alert Message Hook -->\\n                <div id=\\\"step3-error-holder\\\" class=\\\"hidden mb-4 p-4 bg-amber-50 border border-amber-200 rounded-2xl text-amber-800 text-sm flex items-center gap-2\\\">\\n                    <i class=\\\"fa-solid fa-circle-exclamation\\\"></i>\\n                    <span id=\\\"step3-error-text\\\"></span>\\n                </div>\\n                \\n                <div class=\\\"flex gap-3\\\">\\n                    <button onclick=\\\"finishAndCalculate()\\\" type=\\\"button\\\" \\n                            class=\\\"w-full bg-emerald-600 hover:bg-emerald-700 text-white py-4 rounded-3xl font-semibold text-lg shadow-md shadow-emerald-100 transition-colors\\\">\\n                        Calculate Final Split\\n                    </button>\\n                </div>\\n                \\n                \u003C!-- Section Container: Added Items & Running Total -->\\n                <div class=\\\"mt-10 space-y-4\\\">\\n                    <h3 class=\\\"font-medium text-gray-700 flex items-center gap-2\\\">\\n                        <i class=\\\"fa-solid fa-list\\\"></i> Added Items &amp; Savings\\n                    </h3>\\n\\n                    \u003C!-- Running Total Field Widget for Receipt Auditing -->\\n                    <div class=\\\"bg-indigo-900 text-white rounded-2xl p-5 shadow-inner flex justify-between items-center\\\">\\n                        <div>\\n                            <div class=\\\"text-xs text-indigo-200 uppercase tracking-wider font-semibold\\\">Total Cost (Running Balance)</div>\\n                            <p class=\\\"text-xs text-indigo-300 mt-1\\\">Matches the exact final balance on your paper receipt</p>\\n                        </div>\\n                        <div class=\\\"text-right\\\">\\n                            <span id=\\\"running-total-cost\\\" class=\\\"title-font text-3xl font-bold tracking-tight text-emerald-400\\\">\u20AC0.00</span>\\n                        </div>\\n                    </div>\\n\\n                    <div id=\\\"added-items-list\\\" class=\\\"space-y-3 max-h-96 overflow-auto pr-2\\\"></div>\\n                </div>\\n            </div>\\n\\n            \u003C!-- STEP 4: Results -->\\n            <div id=\\\"step-4\\\" class=\\\"hidden space-y-6\\\">\\n                <div class=\\\"text-center\\\">\\n                    <div class=\\\"inline-flex items-center justify-center w-16 h-16 bg-emerald-100 text-emerald-600 rounded-2xl mb-4\\\">\\n                        <i class=\\\"fa-solid fa-check text-3xl\\\"></i>\\n                    </div>\\n                    <h2 class=\\\"text-3xl font-semibold text-gray-900\\\">Split Complete!</h2>\\n                    <p class=\\\"text-gray-600 mt-1\\\" id=\\\"payer-summary\\\"></p>\\n                </div>\\n                <div id=\\\"results-container\\\" class=\\\"space-y-4\\\"></div>\\n                <button onclick=\\\"resetApp()\\\" type=\\\"button\\\" class=\\\"w-full mt-8 py-4 border border-gray-300 hover:bg-gray-50 rounded-3xl text-gray-700 font-medium\\\">\\n                    Split Another Bill\\n                </button>\\n            </div>\\n        </div>\\n\\n        \u003C!-- INLINE INSTRUCTIONS VIEW -->\\n        <div id=\\\"instructions-view\\\" class=\\\"hidden flex-1 p-6 bg-white overflow-auto\\\">\\n            <h2 class=\\\"text-2xl font-semibold mb-6 flex items-center gap-3\\\">\\n                <i class=\\\"fa-solid fa-circle-info text-indigo-600\\\"></i> How to Use\\n            </h2>\\n            <div class=\\\"space-y-5 text-gray-700 text-base leading-relaxed bg-indigo-50/50 p-6 rounded-3xl border border-indigo-100 mb-6\\\">\\n                <p><strong>Select Currency:</strong> Choose your preferred currency from the dropdown menu at the top.</p>\\n                <p><strong>Enter Who Paid the Bill:</strong> Type the name of the person who paid the full bill. This is the person who will be refunded by the others.</p>\\n                <p><strong>How many people in total?</strong> Select or enter how many people are sharing the bill (including the payer).</p>\\n                <p><strong>Enter Everyone\u2019s Names:</strong> Enter the names of all the other people participating in the split.</p>\\n                <p><strong>Add Items from the Shopping Bill:</strong> Enter the original Item Cost. If there is a discount, enter it in the Item Discount field. Tick the checkboxes of people who should share that item.</p>\\n                <p><strong>Apply Store Vouchers:</strong> Enter any general store vouchers or discounts in the Store Voucher section. It will automatically apply an even deduction to everyone on the bill.</p>\\n                <p><strong>Track Total Cost Balance:</strong> Look at the dark blue running total card. It continually computes the net bill value after factoring in item costs, discounts, and store vouchers so you can verify it directly against your actual shop receipt total before splitting.</p>\\n                <p><strong>Make Changes if Needed:</strong> Click the red trash icon to delete any incorrect item or voucher entry.</p>\\n                <p><strong>Finish and Calculate:</strong> Click \u201CCalculate Final Split\u201D to see exactly how much each person owes the payer.</p>\\n            </div>\\n            <button onclick=\\\"hideInstructions()\\\" type=\\\"button\\\" \\n                    class=\\\"w-full bg-indigo-600 hover:bg-indigo-700 text-white py-4 rounded-3xl font-semibold text-lg\\\">\\n                Got it, take me back\\n            </button>\\n        </div>\\n\\n        \u003C!-- INLINE STEP-1 NOTICES HUB -->\\n        <div id=\\\"step1-error-holder\\\" class=\\\"hidden mx-6 mb-4 p-4 bg-amber-50 border border-amber-200 rounded-2xl text-amber-800 text-sm flex items-center gap-2\\\">\\n            <i class=\\\"fa-solid fa-circle-exclamation\\\"></i>\\n            <span id=\\\"step1-error-text\\\"></span>\\n        </div>\\n\\n    </div>\\n\\n    <script>\\n        let payer = \\\"\\\";\\n        let people = [];\\n        let items = [];\\n        let currentItemNum = 1;\\n        let selectedCurrency = \\\"EUR\\\";\\n        let currencySymbol = \\\"\u20AC\\\";\\n        let armedDeleteIndex = null;\\n        let armedTimeout = null;\\n\\n        const currencyMap = {\\n            \\\"EUR\\\": \\\"\u20AC\\\", \\\"USD\\\": \\\"$\\\", \\\"GBP\\\": \\\"\u00A3\\\", \\\"INR\\\": \\\"\u20B9\\\",\\n            \\\"CAD\\\": \\\"C$\\\", \\\"AUD\\\": \\\"A$\\\", \\\"JPY\\\": \\\"\u00A5\\\"\\n        };\\n\\n        function showInstructions() {\\n            document.getElementById(\\\"main-content\\\").classList.add(\\\"hidden\\\");\\n            document.getElementById(\\\"instructions-view\\\").classList.remove(\\\"hidden\\\");\\n        }\\n\\n        function hideInstructions() {\\n            document.getElementById(\\\"instructions-view\\\").classList.add(\\\"hidden\\\");\\n            document.getElementById(\\\"main-content\\\").classList.remove(\\\"hidden\\\");\\n        }\\n\\n        function triggerStep1Error(msg) {\\n            const holder = document.getElementById(\\\"step1-error-holder\\\");\\n            document.getElementById(\\\"step1-error-text\\\").textContent = msg;\\n            holder.classList.remove(\\\"hidden\\\");\\n            holder.scrollIntoView({ behavior: 'smooth', block: 'nearest' });\\n        }\\n        function clearStep1Error() {\\n            document.getElementById(\\\"step1-error-holder\\\").classList.add(\\\"hidden\\\");\\n        }\\n\\n        function triggerStep3Error(msg) {\\n            const holder = document.getElementById(\\\"step3-error-holder\\\");\\n            document.getElementById(\\\"step3-error-text\\\").textContent = msg;\\n            holder.classList.remove(\\\"hidden\\\");\\n        }\\n        function clearStep3Error() {\\n            document.getElementById(\\\"step3-error-holder\\\").classList.add(\\\"hidden\\\");\\n        }\\n\\n        function updateCurrency() {\\n            selectedCurrency = document.getElementById(\\\"currency-select\\\").value;\\n            currencySymbol = currencyMap[selectedCurrency] || \\\"\u20AC\\\";\\n            document.querySelectorAll(\\\"#cost-currency, #disc-currency, #voucher-currency\\\").forEach(el => el.textContent = currencySymbol);\\n            calculateRunningTotal();\\n        }\\n\\n        function setPeople(n) {\\n            document.getElementById(\\\"num-people\\\").value = n;\\n            document.getElementById(\\\"num-people\\\").classList.add(\\\"hidden\\\");\\n            updateActivePeopleButton(`btn-people-${n}`);\\n            clearStep1Error();\\n        }\\n\\n        function showCustomPeople() {\\n            const input = document.getElementById(\\\"num-people\\\");\\n            input.classList.remove(\\\"hidden\\\");\\n            input.value = \\\"\\\";\\n            input.focus();\\n            updateActivePeopleButton('btn-people-custom');\\n            clearStep1Error();\\n        }\\n\\n        function handleCustomInput(val) {\\n            updateActivePeopleButton('btn-people-custom');\\n            clearStep1Error();\\n        }\\n\\n        function updateActivePeopleButton(activeId) {\\n            const buttons = ['btn-people-2', 'btn-people-3', 'btn-people-4', 'btn-people-5', 'btn-people-custom'];\\n            buttons.forEach(id => {\\n                const btn = document.getElementById(id);\\n                if (id === activeId) {\\n                    btn.className = \\\"flex-1 py-4 bg-indigo-600 border-2 border-indigo-600 text-white rounded-3xl text-lg font-semibold transition-all duration-200 shadow-md shadow-indigo-100\\\";\\n                } else {\\n                    btn.className = \\\"flex-1 py-4 bg-white border-2 border-gray-200 text-gray-900 rounded-3xl text-lg font-semibold transition-all duration-200 hover:border-gray-300\\\";\\n                }\\n            });\\n        }\\n\\n        function sanitizeNumericInput(input) {\\n            clearStep3Error();\\n            let sanitized = input.value.replace(/[^0-9.]/g, '');\\n            \\n            const parts = sanitized.split('.');\\n            if (parts.length > 2) {\\n                sanitized = parts[0] + '.' + parts.slice(1).join('');\\n            }\\n            \\n            if (parts[1] && parts[1].length > 2) {\\n                sanitized = parseFloat(sanitized).toFixed(2);\\n            }\\n            \\n            input.value = sanitized;\\n        }\\n\\n        function goToStep2() {\\n            clearStep1Error();\\n            updateCurrency();\\n            payer = document.getElementById(\\\"payer-name\\\").value.trim();\\n            \\n            if (!payer) {\\n                triggerStep1Error(\\\"Please enter the name of who paid the bill.\\\");\\n                return;\\n            }\\n\\n            let num = parseInt(document.getElementById(\\\"num-people\\\").value);\\n            if (!num || num < 2) {\\n                triggerStep1Error(\\\"Please select or enter how many people are sharing this bill.\\\");\\n                return;\\n            }\\n\\n            people = [payer];\\n            const container = document.getElementById(\\\"names-container\\\");\\n            container.innerHTML = `\\n                <div class=\\\"bg-indigo-50 border border-indigo-200 rounded-2xl p-4\\\">\\n                    <div class=\\\"flex items-center gap-3\\\">\\n                        <i class=\\\"fa-solid fa-crown text-amber-500\\\"></i>\\n                        <div>\\n                            <div class=\\\"text-xs uppercase tracking-widest text-indigo-500 font-medium\\\">Payer</div>\\n                            <div class=\\\"font-medium\\\">${payer}</div>\\n                        </div>\\n                    </div>\\n                </div>\\n            `;\\n\\n            for (let i = 1; i < num; i++) {\\n                container.innerHTML += `\\n                    <div>\\n                        <input type=\\\"text\\\" id=\\\"person-${i}\\\" placeholder=\\\"Person ${i + 1} name\\\"\\n                               class=\\\"w-full px-4 py-3 border border-gray-300 rounded-2xl focus:outline-none focus:ring-2 focus:ring-indigo-500\\\">\\n                    </div>\\n                `;\\n            }\\n\\n            document.getElementById(\\\"step-1\\\").classList.add(\\\"hidden\\\");\\n            document.getElementById(\\\"step-2\\\").classList.remove(\\\"hidden\\\");\\n        }\\n\\n        function backToStep1() {\\n            document.getElementById(\\\"step-2\\\").classList.add(\\\"hidden\\\");\\n            document.getElementById(\\\"step-1\\\").classList.remove(\\\"hidden\\\");\\n        }\\n\\n        function goToStep3() {\\n            people = [payer];\\n            let i = 1;\\n            while (document.getElementById(`person-${i}`)) {\\n                const name = document.getElementById(`person-${i}`).value.trim();\\n                if (name) people.push(name);\\n                i++;\\n            }\\n            \\n            if (people.length < 2) {\\n                document.getElementById(\\\"step-2\\\").classList.add(\\\"hidden\\\");\\n                document.getElementById(\\\"step-1\\\").classList.remove(\\\"hidden\\\");\\n                triggerStep1Error(\\\"Please enter names for everyone.\\\");\\n                return;\\n            }\\n\\n            items = [];\\n            currentItemNum = 1;\\n            clearStep3Error();\\n            renderAddedItems();\\n            renderCheckboxes();\\n\\n            document.getElementById(\\\"step-2\\\").classList.add(\\\"hidden\\\");\\n            document.getElementById(\\\"step-3\\\").classList.remove(\\\"hidden\\\");\\n        }\\n\\n        function renderCheckboxes() {\\n            const container = document.getElementById(\\\"checkboxes-container\\\");\\n            container.innerHTML = \\\"\\\";\\n            people.forEach((person, index) => {\\n                const div = document.createElement(\\\"div\\\");\\n                div.className = \\\"flex items-center gap-3 bg-white border border-gray-200 rounded-2xl px-4 py-3\\\";\\n                div.innerHTML = `\\n                    <input type=\\\"checkbox\\\" id=\\\"check-${index}\\\" onchange=\\\"clearStep3Error()\\\" class=\\\"w-5 h-5 accent-indigo-600\\\">\\n                    <label for=\\\"check-${index}\\\" class=\\\"font-medium cursor-pointer flex-1\\\">${person}</label>\\n                `;\\n                container.appendChild(div);\\n            });\\n        }\\n\\n        function calculateRunningTotal() {\\n            let totalRunningCost = 0;\\n            items.forEach(item => {\\n                totalRunningCost += item.effectiveCost;\\n            });\\n            // Edge-case handler: protect visual parsing from clean -0.00 limits\\n            if (Math.abs(totalRunningCost) < 0.005) totalRunningCost = 0;\\n\\n            const totalField = document.getElementById(\\\"running-total-cost\\\");\\n            if (totalField) {\\n                totalField.textContent = `${currencySymbol}${totalRunningCost.toFixed(2)}`;\\n            }\\n        }\\n\\n        function addItem() {\\n            clearStep3Error();\\n            const costStr = document.getElementById(\\\"item-cost\\\").value.trim();\\n            const discountStr = document.getElementById(\\\"item-discount\\\").value.trim();\\n\\n            const cost = parseFloat(costStr) || 0;\\n            const discount = parseFloat(discountStr) || 0;\\n            const effectiveCost = Math.max(0, cost - discount);\\n\\n            if (effectiveCost <= 0) {\\n                triggerStep3Error(\\\"Please enter a valid item cost.\\\");\\n                return;\\n            }\\n\\n            const checkedPeople = [];\\n            people.forEach((_, index) => {\\n                const cb = document.getElementById(`check-${index}`);\\n                if (cb && cb.checked) checkedPeople.push(people[index]);\\n            });\\n\\n            if (checkedPeople.length === 0) {\\n                triggerStep3Error(\\\"Please select at least one person for this item.\\\");\\n                return;\\n            }\\n\\n            items.push({\\n                type: \\\"item\\\",\\n                number: currentItemNum,\\n                cost: cost,\\n                discount: discount,\\n                effectiveCost: effectiveCost,\\n                participants: checkedPeople\\n            });\\n\\n            currentItemNum++;\\n            renderAddedItems();\\n\\n            document.getElementById(\\\"item-cost\\\").value = \\\"\\\";\\n            document.getElementById(\\\"item-discount\\\").value = \\\"0\\\";\\n            people.forEach((_, i) => {\\n                const cb = document.getElementById(`check-${i}`);\\n                if (cb) cb.checked = false;\\n            });\\n        }\\n\\n        function addVoucher() {\\n            clearStep3Error();\\n            const voucherStr = document.getElementById(\\\"store-voucher\\\").value.trim();\\n            const voucherValue = parseFloat(voucherStr) || 0;\\n\\n            if (voucherValue <= 0) {\\n                triggerStep3Error(\\\"Please enter a valid store voucher value.\\\");\\n                return;\\n            }\\n\\n            // A Store Voucher always splits equally between all members of the entire group\\n            items.push({\\n                type: \\\"voucher\\\",\\n                cost: 0,\\n                discount: voucherValue,\\n                effectiveCost: -voucherValue, // Render as a clean negative deduction\\n                participants: [...people]     // Distributed across everyone\\n            });\\n\\n            renderAddedItems();\\n            document.getElementById(\\\"store-voucher\\\").value = \\\"\\\";\\n        }\\n\\n        function renderAddedItems() {\\n            const list = document.getElementById(\\\"added-items-list\\\");\\n            list.innerHTML = \\\"\\\";\\n            \\n            // Count only standard products, not vouchers\\n            const baseItemsCount = items.filter(i => i.type === \\\"item\\\").length;\\n            document.getElementById(\\\"item-counter\\\").textContent = baseItemsCount;\\n\\n            calculateRunningTotal();\\n\\n            items.forEach((item, index) => {\\n                const isVoucher = (item.type === \\\"voucher\\\");\\n                const participantsText = item.participants.length === people.length ? \\\"Everyone\\\" : item.participants.join(\\\" & \\\");\\n                const share = item.effectiveCost / item.participants.length;\\n                const isArmed = (armedDeleteIndex === index);\\n\\n                let badgeHtml = `<div class=\\\"w-7 h-7 bg-gray-100 text-gray-600 rounded-xl flex items-center justify-center text-sm font-medium\\\">${item.number || '\u2022'}</div>`;\\n                let priceDisplay = \\\"\\\";\\n                let shareDisplay = \\\"\\\";\\n                let cardBackgroundClass = isArmed ? 'bg-red-50 border-red-300' : 'bg-white border-gray-200';\\n\\n                if (isVoucher) {\\n                    badgeHtml = `<div class=\\\"w-7 h-7 bg-amber-500 text-white rounded-xl flex items-center justify-center text-xs\\\"><i class=\\\"fa-solid fa-ticket\\\"></i></div>`;\\n                    priceDisplay = `<span class=\\\"text-amber-700 font-semibold uppercase tracking-wider text-xs bg-amber-100 px-2 py-0.5 rounded-md mr-2\\\">Voucher</span><span class=\\\"font-bold text-red-600\\\">-${currencySymbol}${item.discount.toFixed(2)}</span>`;\\n                    shareDisplay = `<div class=\\\"text-red-600 font-medium\\\">-${currencySymbol}${Math.abs(share).toFixed(2)} each</div>`;\\n                    if (!isArmed) cardBackgroundClass = 'bg-amber-50/40 border-amber-200/70';\\n                } else {\\n                    priceDisplay = item.discount > 0 \\n                        ? `${currencySymbol}${item.cost.toFixed(2)} - ${currencySymbol}${item.discount.toFixed(2)} = <span class=\\\"font-semibold\\\">${currencySymbol}${item.effectiveCost.toFixed(2)}</span>`\\n                        : `${currencySymbol}${item.effectiveCost.toFixed(2)}`;\\n                    shareDisplay = `<div class=\\\"text-emerald-600 font-medium\\\">${currencySymbol}${share.toFixed(2)} each</div>`;\\n                }\\n\\n                const div = document.createElement(\\\"div\\\");\\n                div.className = `item-card transition-all duration-200 border rounded-2xl p-4 flex justify-between items-center ${cardBackgroundClass}`;\\n                \\n                div.innerHTML = `\\n                    <div class=\\\"flex items-center gap-4\\\">\\n                        ${badgeHtml}\\n                        <div>\\n                            <div class=\\\"font-medium flex items-center\\\">${priceDisplay}</div>\\n                            <div class=\\\"text-xs text-gray-500 mt-0.5\\\">${participantsText}</div>\\n                        </div>\\n                    </div>\\n                    <div class=\\\"flex items-center gap-4\\\">\\n                        <div class=\\\"text-right\\\">\\n                            ${shareDisplay}\\n                        </div>\\n                        <div class=\\\"relative\\\">\\n                            ${isArmed ? `\\n                                <button onclick=\\\"confirmDelete(${index})\\\" type=\\\"button\\\" class=\\\"bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-3 py-2 rounded-xl shadow-sm\\\">\\n                                    Confirm?\\n                                </button>\\n                            ` : `\\n                                <button onclick=\\\"armDelete(${index})\\\" type=\\\"button\\\" class=\\\"text-gray-400 hover:text-red-500 p-2 transition-colors\\\">\\n                                    <i class=\\\"fa-solid fa-trash\\\"></i>\\n                                </button>\\n                            `}\\n                        </div>\\n                    </div>\\n                `;\\n                list.appendChild(div);\\n            });\\n        }\\n\\n        function armDelete(index) {\\n            if (armedTimeout) clearTimeout(armedTimeout);\\n            armedDeleteIndex = index;\\n            renderAddedItems();\\n            \\n            armedTimeout = setTimeout(() => {\\n                armedDeleteIndex = null;\\n                renderAddedItems();\\n            }, 4000);\\n        }\\n\\n        function confirmDelete(index) {\\n            if (armedTimeout) clearTimeout(armedTimeout);\\n            armedDeleteIndex = null;\\n            \\n            items.splice(index, 1);\\n            \\n            // Re-sequence item counters clean while keeping vouchers safe\\n            let currentTrackNum = 1;\\n            items.forEach((item) => {\\n                if (item.type === \\\"item\\\") {\\n                    item.number = currentTrackNum;\\n                    currentTrackNum++;\\n                }\\n            });\\n            currentItemNum = currentTrackNum;\\n            \\n            clearStep3Error();\\n            renderAddedItems();\\n        }\\n\\n        function finishAndCalculate() {\\n            clearStep3Error();\\n            if (items.length === 0) {\\n                triggerStep3Error(\\\"Please add at least one item or voucher before calculating.\\\");\\n                return;\\n            }\\n\\n            const owes = {};\\n            people.forEach(person => { if (person !== payer) owes[person] = 0; });\\n\\n            items.forEach(item => {\\n                const share = item.effectiveCost / item.participants.length;\\n                item.participants.forEach(person => {\\n                    if (person !== payer) {\\n                        owes[person] = (owes[person] || 0) + share;\\n                    }\\n                });\\n            });\\n\\n            const container = document.getElementById(\\\"results-container\\\");\\n            container.innerHTML = \\\"\\\";\\n            let totalOwed = 0;\\n\\n            Object.keys(owes).forEach(person => {\\n                let amount = owes[person];\\n                // Floor it at zero just in case big vouchers drop a balance into negative territory\\n                if (amount < 0) amount = 0;\\n                \\n                totalOwed += amount;\\n                const div = document.createElement(\\\"div\\\");\\n                div.className = \\\"bg-white border border-gray-200 rounded-3xl p-6 flex justify-between items-center\\\";\\n                div.innerHTML = `\\n                    <div class=\\\"flex items-center gap-4\\\">\\n                        <div class=\\\"text-2xl\\\">\uD83D\uDC64</div>\\n                        <div>\\n                            <div class=\\\"font-semibold text-lg\\\">${person}</div>\\n                            <div class=\\\"text-sm text-gray-500\\\">owes ${payer}</div>\\n                        </div>\\n                    </div>\\n                    <div class=\\\"text-right\\\">\\n                        <div class=\\\"text-3xl font-semibold text-emerald-600\\\">${currencySymbol}${amount.toFixed(2)}</div>\\n                    </div>\\n                `;\\n                container.appendChild(div);\\n            });\\n\\n            document.getElementById(\\\"payer-summary\\\").innerHTML = `\\n                ${payer} paid everything.<br>\\n                Total to be received: <span class=\\\"font-semibold\\\">${currencySymbol}${totalOwed.toFixed(2)}</span>\\n            `;\\n\\n            document.getElementById(\\\"step-3\\\").classList.add(\\\"hidden\\\");\\n            document.getElementById(\\\"step-4\\\").classList.remove(\\\"hidden\\\");\\n        }\\n\\n        function resetApp() {\\n            payer = \\\"\\\"; people = []; items = []; currentItemNum = 1;\\n            armedDeleteIndex = null;\\n            if (armedTimeout) clearTimeout(armedTimeout);\\n            \\n            document.getElementById(\\\"step-4\\\").classList.add(\\\"hidden\\\");\\n            document.getElementById(\\\"step-1\\\").classList.remove(\\\"hidden\\\");\\n            document.getElementById(\\\"added-items-list\\\").innerHTML = \\\"\\\";\\n            document.getElementById(\\\"payer-name\\\").value = \\\"\\\";\\n            document.getElementById(\\\"num-people\\\").classList.add(\\\"hidden\\\");\\n            document.getElementById(\\\"num-people\\\").value = \\\"\\\";\\n            document.getElementById(\\\"store-voucher\\\").value = \\\"\\\";\\n            \\n            clearStep1Error();\\n            clearStep3Error();\\n            updateActivePeopleButton(null);\\n        }\\n\\n        document.getElementById(\\\"currency-select\\\").addEventListener(\\\"change\\\", updateCurrency);\\n    <$script>\\n</body>\\n</html>\",\"iframeHeight\":\"10000\",\"order\":0,\"widgetId\":\"d92abab5-acbc-400b-9be8-6b59db3fc854\",\"section\":\"default\",\"category\":\"primary\",\"locale\":\"en-IE\",\"env\":\"production\",\"renderMode\":\"PUBLISH\"}"),context:JSON.parse("{\"widgetId\":\"d92abab5-acbc-400b-9be8-6b59db3fc854\",\"widgetType\":\"HTML\",\"widgetPreset\":\"html1\",\"group\":\"Section\",\"groupType\":\"Default\",\"section\":\"default\",\"category\":\"primary\",\"fontSize\":\"medium\",\"fontFamily\":\"alternate\",\"websiteThemeOverrides\":{\"ButtonPrimary\":{\"value\":{\"color\":\"PRIMARY\",\"decoration\":\"NONE\",\"fill\":\"SOLID\",\"shadow\":\"NONE\",\"shape\":\"SQUARE\",\"size\":\"default\"}},\"ButtonSpotlight\":{\"value\":{\"shape\":\"SQUARE\",\"decoration\":\"NONE\",\"shadow\":\"NONE\",\"color\":\"PRIMARY\"}},\"ButtonSecondary\":{\"value\":{\"color\":\"PRIMARY\",\"decoration\":\"NONE\",\"fill\":\"SOLID\",\"shadow\":\"NONE\",\"shape\":\"SQUARE\",\"size\":\"default\"}},\"ButtonExternal\":{\"value\":{\"shape\":\"SQUARE\"}}},\"widgetThemeOverrides\":{},\"resizeHeight\":\"0\"}"),contextKey:'context-bs-1',radpack:"@widget/HTML/bs-Component"},false);
window.wsb["CookieBannerScript"]=function({id:e,acceptCookie:t,dismissCookie:o}){let a,n,i;function l(e,t=60){const o=new Date;o.setTime(o.getTime()+864e5*t);const a=`expires=${o.toUTCString()}`;document.cookie=`${e}=true;${a};path=/`}function r(e){document.cookie=`${e}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/`}function s(e){return document.cookie.includes(e)}function c(){n&&n.removeEventListener("click",d),i&&i.removeEventListener("click",u),a.style.display="none"}function p(){window._allowCT=!0,window._allowCTListener&&window._allowCTListener.forEach((e=>e()))}function g(){s(o)||(a=document.getElementById(`${e}-banner`),n=document.getElementById(`${e}-accept`),i=document.getElementById(`${e}-decline`),n&&n.addEventListener("click",d),i&&i.addEventListener("click",u),a.style.transform="translateY(-500px)")}function d(e){e.preventDefault(),p(),l(o),l(t),c()}function u(e){e.preventDefault(),l(o),s(t)&&r(t),c()}!s(t)||navigator.globalPrivacyControl?setTimeout((()=>{navigator.globalPrivacyControl?(window._allowCT=!1,s(o)&&r(o),s(t)&&r(t),c()):g()}),200):p()};
